@using PaupProjekt.Models
@model uslugeTab


@{
    ViewBag.Title = "UrediUslugu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>UrediUslugu</h2>

@using (Html.BeginForm("UrediUslugu", "Usluge", FormMethod.Post))
{

    @Html.HiddenFor(model => model.UslugaID);
    @Html.LabelFor(model => model.nazivUsluga)
    @Html.TextBoxFor(model => model.nazivUsluga);
    <br />
    @Html.LabelFor(model => model.cijenaUsluga)
    @Html.TextBoxFor(model => model.cijenaUsluga);
    @Html.ActionLink("Odustani", "ListaUsluga", null, new { @class = "btn btn-secondary" })
    <button class="btn btn-primary"> spremi promjene</button>

}
