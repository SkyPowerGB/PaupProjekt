@using PaupProjekt.Models
@model List<uslugeTab>
@{
    ViewBag.Title = "ListaUsluga";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>ListaUsluga</h2>
@Html.ActionLink("Dodaj uslugu", "DodajUslugu");
@if (Model.Count > 0)
{
    <table class="table-bordered text-center ">
        <thead>
            <tr>
                <th>Naziv</th>
                <th>Cijena usluge</th>
                <th></th>
            </tr>

        </thead>
        <tbody>
            @foreach (uslugeTab usluga in Model)
            {
                <tr>
                    <td>
                        @usluga.nazivUsluga
                    </td>
                    <td>
                        @usluga.cijenaUsluga
                        Eurž
                    </td>
                    <td>@Html.ActionLink("Uredi", "UrediUslugu", new { id = usluga.UslugaID })</td>
                    <td>@Html.ActionLink("Obriši", "ObrisiUslugu", new { idUsluge = usluga.UslugaID })</td>
                </tr>
            }



        </tbody>


    </table>
}
else
{
    <h3>Nema usluga</h3>

}


