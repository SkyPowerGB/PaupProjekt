@using PaupProjekt.Models
@model List<uslugeTab>
@{
    ViewBag.Title = "ListaUsluga";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container-fluid">
    <div class="col-12">
        <h2 class="text-center">Lista Usluga</h2>
        <div class="text-end">
            @using (Html.BeginForm("ListaUsluga", "Usluge", FormMethod.Get))
            {
                @Html.TextBox("naziv");
                <button class="bi bi-search">Traži</button>
            }
        </div>



        @if (Model.Count > 0)
        {

            <table class="table table-striped text-center ">
                <thead>
                    <tr>
                        <th>Naziv</th>
                        <th>Cijena usluge</th>
                        <th>@Html.ActionLink(" Nova Usluga", "DodajUslugu", null, new { @class = "btn btn-outline-primary  bi bi-plus-square-dotted" })</th>
                    </tr>

                </thead>
                <tbody>
                    @foreach (uslugeTab usluga in Model)
                    {
                        <tr>
                            <td>
                                @usluga.nazivUsluga
                            </td>
                            <td>
                                @usluga.cijenaUsluga
                                Eur
                            </td>


                            <td>@Html.ActionLink("Uredi", "UrediUslugu", new { id = usluga.UslugaID }, new { @class = "btn btn-outline-primary" })</td>
                            <td>@Html.ActionLink("Obriši", "ObrisiUslugu", new { idUsluge = usluga.UslugaID }, new { @class = "btn btn-danger bi bi-trash3-fill" })</td>
                        </tr>
                    }



                </tbody>


            </table>
        }
        else
        {
            <h3>Nema usluga</h3>

        }

    </div>
</div>