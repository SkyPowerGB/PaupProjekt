@model PaupProjekt.Models.uslugeTab

@{
    ViewBag.Title = "DodajUslugu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Kreiranje nove usluge</h2>

@using (Html.BeginForm("DodajUslugu", "Usluge", FormMethod.Post))
{
    <div class="form-group">
        @Html.LabelFor(model => model.nazivUsluga)
        @Html.TextBoxFor(model => model.nazivUsluga, new { @class = "form-control" })
        @Html.ValidationMessageFor(model => model.nazivUsluga, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.cijenaUsluga)
        @Html.TextBoxFor(model => model.cijenaUsluga, new { @class = "form-control" })
        @Html.ValidationMessageFor(model => model.cijenaUsluga, "", new { @class = "text-danger" })
    </div>

    <br />
    <div class="form-group">
        @Html.ActionLink("Nazad", "ListaUsluga", null, new { @class = "btn btn-secondary" })
        <button type="submit" class="btn btn-primary">+Dodaj uslugu</button>
    </div>
}