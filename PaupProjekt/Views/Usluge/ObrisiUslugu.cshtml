@using PaupProjekt.Models
@model uslugeTab
@{
    ViewBag.Title = "ObrisiUslugu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Obriši Uslugu</h2>
@ViewBag.Title

<div>

    @using (Html.BeginForm("ObrisiUslugu", "Usluge", FormMethod.Post))
    {
        @Html.Hidden("Id", Model.UslugaID);


        @Html.ActionLink("odustani", "ListaUsluga", null, new { @class = "btn btn-primary" });
        <button class="btn btn-danger"> Izbrisi </button>

    }


</div>