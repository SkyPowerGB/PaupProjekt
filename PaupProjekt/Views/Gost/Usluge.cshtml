
@{
    ViewBag.Title = "Usluge";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Usluge</h2>


<p>
    Redovno održavanje vozila: Pružanje rutinskog servisa, uključujući zamjenu ulja i filtera, provjeru tekućina, provjeru kočnica i guma te zamjenu svjećica.
    <br>
    @if (User.Identity.IsAuthenticated)
    {
        @Html.ActionLink("Narucite se na redovno održavanje", "Index", "Narudzbe", new { usluga = "Redovni Servis", trebaSlika = false }, null);
    }
    else
    {
        <a class="btn btn-outline-primary" href="@Url.Action("Login","Autentifikacijski")">Prijava</a>
    }
    <br>


    Dijagnostika i popravka motora: Pružanje usluga dijagnostike problema s motorom te popravke i zamjene oštećenih dijelova.
