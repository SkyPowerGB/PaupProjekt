
@{
    ViewBag.Title = "Usluge";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Usluge</h2>

@if (User.Identity.IsAuthenticated)
{
    @Html.ActionLink("Narucite se za zamjenu guma", "Index", "Narudzbe", new { usluga = "Zamjena Guma" , trebaSlika=false},null);
    <br />
    @Html.ActionLink("Narucite se", "Index", "Narudzbe" , new {trebaSlika= true },null);

}
else
{
    <a class="btn btn-outline-primary" href="@Url.Action("Login","Autentifikacijski")">Prijava</a>
}