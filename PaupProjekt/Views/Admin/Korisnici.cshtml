@using PagedList.Mvc
@using PagedList
@using PaupProjekt.Models;
@model PagedList<vlasnik>
@{
    ViewBag.Title = "Korisnici";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="/Content/PagedList.css" rel="stylesheet" type="text/css" />
<div class="container ">

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Prezime Ime</th>
                <th>email</th>

                <th>ovlast</th>
          
            </tr>
        </thead>
        <tbody>
            @foreach (vlasnik kor in Model)
            {
                <tr>
                    <td>@kor.PrezimeIme</td>
                    <td>@kor.Email</td>
                    <td>@(kor.Ovlast?.naziv)</td>

                    <td>@Html.ActionLink("Uredi", "uredi", new { id = kor.VlasnikID }, new { @class = "btn btn-primary" })</td>

                    <td>@Html.ActionLink("Brisi", "izbrisi", new { id = kor.VlasnikID }, new { @class = "btn btn-danger" })</td>

                   

                </tr>
            }



        </tbody>


    </table>

    @Html.PagedListPager(Model, page => Url.Action("Korisnici", new { i = page }))

</div>

