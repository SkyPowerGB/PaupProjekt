@using PaupProjekt.Models
@model vlasnik
@{
    ViewBag.Title = "promjenaLozinke";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="text-center">Promjena Lozinke</h2>

<div class="container d-flex justify-content-center">
    <div class="col-md-6">
        @using (Html.BeginForm("promjenaLozinke", "Admin", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div class=col-4>
                @Html.HiddenFor(model => model.sifraOvlast)
                @Html.HiddenFor(model => model.VlasnikID)
                @Html.HiddenFor(model => model.Lozinka)
                @Html.HiddenFor(model => model.Email)
                @Html.HiddenFor(model => model.Ime)
                @Html.HiddenFor(model => model.Prezime)
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.LozinkaA, htmlAttributes: new { @class = "form-label" })
                @Html.PasswordFor(model => model.LozinkaA, htmlAttributes: new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.LozinkaA);
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.LozinkaPon, htmlAttributes: new { @class = "form-label" })
                @Html.PasswordFor(model => model.LozinkaPon, htmlAttributes: new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.LozinkaPon);
            </div>

            <div class="d-flex justify-content-between">
                @Html.ActionLink("Odustani", "Korisnici", "Admin", null, new { @class = "btn btn-secondary" })
                <button type="submit" class="btn btn-primary">Promjeni lozinku</button>
            </div>
        }
    </div>
</div>