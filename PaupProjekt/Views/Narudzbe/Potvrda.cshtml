@using PaupProjekt.Models
@model servis
@{
    ViewBag.Title = "Potvrda";
    Layout = "~/Views/Shared/_Layout.cshtml";
    vlasnik vlas = null;
    vozilo voz = null;
    bool notNull = false;

    if (ViewBag.Vozilo != null)
    {
        voz = ((vozilo)ViewBag.Vozilo);
        notNull = true;
    }
    if (ViewBag.Vlasnik != null)
    {

        vlas = ((vlasnik)ViewBag.Vlasnik);
    }


}
<div class="text-center">
    <h2>Potvrda servisa</h2>

    <h4>Podaci o vozilu:</h4>
    @if (notNull)
    {
        <p>@Html.Label(voz.Marka):  @voz.Marka</p>
        <p>@Html.Label(voz.Registracija):@voz.Registracija</p>
        <p>@Html.Label(voz.GodinaProizvodnje.ToString()):@voz.GodinaProizvodnje</p>
    }
    <h5>Slika kvara:</h5>
    @if (Model.slikaVozila != null)
    {
        <img src="@Url.Content(Model.slikaVozila)" width="250" />
    }

    <h4>Podaci o servisu:</h4>

    <p>@Html.LabelFor(model => model.OpisProblema): @Model.OpisProblema</p>
    <p>@Html.LabelFor(model => model.Datum): @Model.Datum</p>



    @using (Html.BeginForm("PotvrdaNarudzbe", "Narudzbe", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.StatusServisa)
        @Html.HiddenFor(model => model.voziloID)
        @Html.HiddenFor(model => model.VlasnikID)
        @Html.HiddenFor(model => model.OpisProblema)
        @Html.HiddenFor(model => model.Datum)
        @Html.HiddenFor(model => model.slikaVozila)

        <div class="mt-3">
            @Html.ActionLink("Odustani", "odustani", new { path = Model.slikaVozila, usluga = Model.OpisProblema }, new { @class = "btn btn-secondary mr-2" })
            <button class="btn btn-primary">Naruči</button>
        </div>
    }
</div>