@using PaupProjekt.Models;
@model servis

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container">
    <div class="row">
        <div class="col-md-6 mx-auto">
            <h2>Novi servis</h2>

            @using (Html.BeginForm("index", "Narudzbe", FormMethod.Post, new { @class = "form-horizontal", role = "form", enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()
                if ((bool)ViewBag.UslugaPoznata)
                {
                    <h6>Opis servisa: @Model.OpisProblema</h6>
                    @Html.HiddenFor(model => model.OpisProblema)
                }
                else
                {
                    <div class="form-group">
                        @Html.LabelFor(model => model.OpisProblema)
                        @Html.TextBoxFor(model => model.OpisProblema, new { @class = "form-control", placeholder = "Opis problema" })
                    </div>
                }

                @Html.HiddenFor(model => model.slikaVozila)
                <div class="form-group">
                    @Html.LabelFor(model => model.slikaVozila)
                    <div>
                        <input type="file" name="ImageFile" id="imageInput" class="form-control" onchange="previewImage(event)" />
                        @Html.ValidationMessageFor(model => model.slikaVozila, "", new { @class = "text-danger" })
                    </div>
                    <div id="imagePreview"></div>
                </div>

                @Html.LabelFor(model => model.VoziloVlasnika.MarkaRegitracija)
                <div class="form-group">
                    @Html.DropDownListFor(model => model.voziloID, new SelectList(((List<vozilo>)(ViewBag.VozilaList)), "voziloId", "MarkaRegitracija"), "- Odaberi Vozilo -")
                    @Html.ActionLink("+ dodaj vozilo", "dodajVozilo", "Korisnik", null, new { @class = "btn btn-outline-primary" })
                </div>

                @Html.HiddenFor(model => model.StatusServisa)
                <br />
                <div>
                    @Html.ActionLink("Nazad", "index", "Korisnik", null, new { @class = "btn btn-secondary" })
                    <button type="submit" class="btn btn-primary">Naruči</button>
                </div>
            }
        </div>
    </div>
</div>

<script>
    function previewImage(event) {
        var reader = new FileReader();
        reader.onload = function () {
            var output = document.getElementById('imagePreview');
            output.innerHTML = '<img src="' + reader.result + '" width="250" />';
        }
        reader.readAsDataURL(event.target.files[0]);
    }
</script>