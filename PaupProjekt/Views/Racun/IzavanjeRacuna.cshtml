@using PaupProjekt.Models
@model List<ListaUslugaTab>
@{
    ViewBag.Title = "IzavanjeRacuna";
    Layout = "~/Views/Shared/_Layout.cshtml";
    račun racun = ViewBag.racun;
}

<h2>@ViewBag.Naslov</h2>

<br />

<table class="table table-striped">
    <thead>
        <tr>
            <th>Naziv</th>
            <th>Cijena</th>
            <th class="border-0">
                @Html.ActionLink("dodaj uslugu", "DodajUslugu", new { id = (int)ViewBag.idNarudzbe }, new { @class = "btn btn-success" })
            </th>
            <th class="border-0">
                @Html.ActionLink("uredi listu usluga", "ListaUsluga", "Usluge", null, new { @class = "btn btn-outline-primary" })
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (ListaUslugaTab ListaUsluga in Model)
        {
            <tr>
                <td>@ListaUsluga.Usluge.nazivUsluga</td>
                <td>@ListaUsluga.kol</td>
                <td>@ListaUsluga.Usluge.cijenaUsluga EUR</td>
                <td>
                    @Html.ActionLink(" ", "MakniUslugu", "Racun", new { idListe = ListaUsluga.idListe }, new { @class = "btn btn-danger bi bi-x-lg" })
                </td>
            </tr>
        }
    </tbody>
</table>

<h2>Ukupan iznos: @racun.UkupanIznos EUR</h2>
@Html.ActionLink("Odustani","klijenti","Radnik",null,new { @class="btn btn-secondary"})
@Html.ActionLink("izdaj Racun","izdajRacun",new { idRacuna=racun.RačunID , iznos=racun.UkupanIznos },new {@class="btn btn-primary" })