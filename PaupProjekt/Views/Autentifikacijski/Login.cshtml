@using PaupProjekt.Models
@model KorisnickaKartica


@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Login</h2>

@using (Html.BeginForm("Login", "Autentifikacijski",
 new { returnUrl = ViewBag.ReturnUrl }, FormMethod.Post, null))
{
    @Html.AntiForgeryToken()
    <div class="form-horizontal">
        @Html.ValidationSummary(false, "", new { @class = "text-danger" })
        <div class="form-group">
            @Html.LabelFor(model => model.Email,
           htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-mld-10">
                @Html.EditorFor(model => model.Email,
               new { htmlAtributes = new { @class = "form-control" } })
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.Lozinka,
           htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-mld-10">
                @Html.EditorFor(model => model.Lozinka,
              new { @class = "form-control" })
            </div>
        </div>
        <div class="form-group">
            <div class="col-sm-offset-2 col-sm-10">
                <br />
                <button type="submit" >
                    Prijava
                </button>
            </div>
        </div>
    </div>
}
