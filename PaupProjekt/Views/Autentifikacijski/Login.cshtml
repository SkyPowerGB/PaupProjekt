@using PaupProjekt.Models
@model KorisnickaKartica


@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6 mx-auto">
            <div   >
                <h2>Prijava</h2>
            </div>
            @using (Html.BeginForm("Login", "Autentifikacijski", new { returnUrl = ViewBag.ReturnUrl }, FormMethod.Post, null))
            {
                @Html.AntiForgeryToken()

                <div class="form-group">
                    @Html.ValidationSummary(false, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.Email, htmlAttributes: new { @class = "control-label" })
                    @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control" } })
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.Lozinka, htmlAttributes: new { @class = "control-label" })
                    @Html.EditorFor(model => model.Lozinka, new { htmlAttributes = new { @class = "form-control" } })
                </div>
                <br />
                <div >
                    <button type="submit" class="btn btn-primary">Prijava</button>
                </div>
            }


            <p>Nemate račun? @Html.ActionLink("Registrirajte se", "Registracija") se besplatno</p>
        </div>

    </div>
    </div>
