
@using PaupProjekt.Models;
@model servis

@{
    ViewBag.Title = "Azuriraj";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <h2>Ažuriraj</h2>

    @using (Html.BeginForm("Azuriraj", "Radnik", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        @Html.HiddenFor(model => model.voziloID)
        @Html.HiddenFor(model => model.VlasnikID)
        @Html.HiddenFor(model => model.Datum)
        @Html.HiddenFor(model => model.ServisID)
        @Html.HiddenFor(model => model.OpisProblema)

        <div class="form-group">
            @Html.LabelFor(model => model.DatumServisa)
            @Html.TextBoxFor(model => model.DatumServisa, new { @class = "form-control" })
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.StatusServisa)
            @Html.DropDownListFor(model => model.StatusServisa, new SelectList(ListaStatusaE.DopusteneVrijednosi), "Odaberi status", new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.StatusServisa, "", new { @class = "text-danger" })
        </div>

        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <h4 class="mt-4"> @Model.OpisProblema</h4>
        <p>@Model.Datum</p>
        <p>@Model.StatusServisa</p>

        <div class="form-group">
            <div  >
                @Html.ActionLink("Nazad", "klijenti", "Radnik", new { area = "" }, new { @class = "btn btn-secondary" })
           
                <button type="submit" class="btn btn-primary">Ažuriraj</button>
            </div>
        </div>

    }

 
</div>