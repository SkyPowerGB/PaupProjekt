

@using PaupProjekt.Models
@model List<servis>

@{
    ViewBag.Title = "klijenti";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>klijenti</h2>


@using (Html.BeginForm("klijenti", "radnik", FormMethod.Get))
{


    @Html.DropDownList("Status", new SelectList(ListaStatusaE.DopusteneVrijednosi))

    <button type="submit"> traži </button>

}


@if (Model.Count > 0)
{



    <table class="table table-bordered">
        <thead>
            <tr>

                <td>Vozilo vlasnika</td>
                <td>marka</td>
                <td>datum</td>
                <td>usluga</td>
                <td>status</td>
            </tr>
        </thead>



        <tbody>

            @foreach (servis Servis in Model)
            {
                <tr>
                    <td>@Servis.VlasnikVozila.PrezimeIme</td>
                    <td>@Servis.VoziloVlasnika.Marka</td>
                    <td>@Servis.Datum</td>
                    <td>@Servis.OpisProblema</td>
                    <td>@Servis.StatusServisa</td>
                    <td>@Html.ActionLink("info", "detalji", new { id = Servis.ServisID })</td>
                    <td>@Html.ActionLink("azuriraj", "Azuriraj", new { id = Servis.ServisID })</td>
                    <td>@Html.ActionLink("izbrisi", "ObrisiNarudzbu", new { id = Servis.ServisID })</td>
                    <td>@Html.ActionLink("IzdavanjeRacuna", "IzavanjeRacuna","Racun", new { idNarudzbe = Servis.ServisID  } ,null)</td>

                </tr>


            }
        </tbody>







        </table>


}
else
{



    <p>Nema  zaprimljenih narudzbi</p>
}

