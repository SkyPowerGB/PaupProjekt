

@using PaupProjekt.Models
@model List<servis>

@{
    ViewBag.Title = "klijenti";
    Layout = "~/Views/Shared/_Layout.cshtml";

    List<račun> Računi = ViewBag.racuni as List<račun>;
    račun racunS = new račun();
}
<h2>Klijenti</h2>


@using (Html.BeginForm("klijenti", "radnik", FormMethod.Get))
{

    @Html.TextBox("prezimeIme")

    @Html.TextBox("marka")

  

    @Html.TextBox("usluga")

    @Html.DropDownList("Status", new SelectList(ListaStatusaE.DopusteneVrijednosi), "Status")


    <button type="submit" class="bi bi-search"> traži </button>

}


@if (Model.Count > 0)
{

    <table class="table table-striped text-center">
        <thead>
            <tr>

                <th>Vozilo vlasnika</th>
                <th>marka</th>
                <th>datum Narudžbe</th>
                <th>usluga</th>
                <th>status</th>
            </tr>
        </thead>



        <tbody>

            @foreach (servis Servis in Model)
            {
                <tr>
                    <td>@Servis.VlasnikVozila.PrezimeIme</td>
                    <td>@Servis.VoziloVlasnika.Marka</td>
                    <td>@Servis.Datum</td>
                    <td>@Servis.OpisProblema</td>
                    <td>@Servis.StatusServisa</td>
                    <td>@Html.ActionLink("info", "detalji", new { id = Servis.ServisID }, new { @class = "btn btn-primary" })</td>
                    <td>@Html.ActionLink("azuriraj", "Azuriraj", new { id = Servis.ServisID }, new { @class = "btn btn-primary" })</td>


                    @if (Računi.FirstOrDefault(x => x.ServisID == Servis.ServisID) != null) { racunS = Računi.FirstOrDefault(x => x.ServisID == Servis.ServisID); }
                    @if (!racunS.Izdan || racunS != null)
                    {

                        <td>@Html.ActionLink("Izdavanje Računa", "IzavanjeRacuna", "Racun", new { idNarudzbe = Servis.ServisID }, new { @class = "btn btn-success" })</td>
                    }
                    @if (racunS.Izdan)
                    {
                        <td>@Html.ActionLink("Pregled računa", "pregledRacuna", "Korisnik", new {servisId=Servis.ServisID }, new {@class="btn btn-primary" })</td>

                    }

                    <td>@Html.ActionLink("izbriši", "ObrisiNarudzbu", new { id = Servis.ServisID }, new { @class = "btn btn-danger  bi bi-trash3-fill" })</td>
                </tr>


            }
        </tbody>







    </table>


}
else
{



    <h2>Nema  zaprimljenih servisa</h2>
}
