

@using PaupProjekt.Models
@model List<servis>

@{
    ViewBag.Title = "klijenti";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>klijenti</h2>
@if (Model.Count > 0 )
{

    <table border="1" class="table-bordered , align-content-center ">
        <tr>
            <th>vozilo</th>
            <th>datum</th>
            <th>usluga</th>
            <th>status</th>
        </tr>





        @foreach (servis Servis in Model)
        {
            <tr>
                <th>@Servis.VlasnikVozila.Ime</th>
                <th>@Servis.Datum</th>
                <th>@Servis.OpisProblema</th>
                <th>@Servis.StatusServisa</th>
                <th>@Html.ActionLink("info", "detalji",new {id=Servis.ServisID})</th>
                <th>@Html.ActionLink("azuriraj", "Azuriraj", new { id = Servis.ServisID})</th>
                <th>@Html.ActionLink("izbrisi", "")</th>

            </tr>


        }







    </table>


}
else
{



    <p>Nema  zaprimljenih narudzbi</p>
}

