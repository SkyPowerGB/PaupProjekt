@using PaupProjekt.Models
@model List<vozilo>
@{
    ViewBag.Title = "Vozila";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Vozila</h2>
@Html.ActionLink("+Dodaj vozilo", "dodajVozilo",null,new {@class= "btn btn-outline-primary" });

@if (Model.Count >= 1)
{


    <table class="table table-striped">
        <thead>
            <tr>
             
                <th> Marka   </th>
                <th> Model  </th>
                <th> Registracija  </th>
                <th> Godina Proizvodnje  </th>
            </tr>
        </thead>

        <tbody>
            @foreach (vozilo Vozilo in Model)
            {
                <tr>
                
                    <td>@Vozilo.Marka</td>
                    <td>@Vozilo.Model</td>
                    <td>@Vozilo.Registracija</td>
                    <td>@Vozilo.GodinaProizvodnje</td>
                    <td>@Html.ActionLink( "obrisiVozilo", "obrisiVozilo", new {idVozila = Vozilo.VoziloId} ,new {@class= "btn btn-danger" })</td>


                </tr>




            }
        </tbody>
    </table>



}






else
{

    <h3>nema vozila</h3>
}