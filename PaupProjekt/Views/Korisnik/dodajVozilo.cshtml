@using PaupProjekt.Models

@model vozilo

@{
    ViewBag.Title = "dodajVozilo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="text-center">dodajVozilo</h2>

<div class="container d-flex justify-content-center">
    <div class="col-md-6">
        @using (Html.BeginForm("dodajVozilo", "Korisnik", FormMethod.Post))
        {
            
            <div class="mb-3">
                @Html.LabelFor(model => model.Model, htmlAttributes: new { @class = "form-label" })
                @Html.TextBoxFor(model => model.Model, htmlAttributes: new { @class = "form-control" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.Marka, htmlAttributes: new { @class = "form-label" })
                @Html.TextBoxFor(model => model.Marka, htmlAttributes: new { @class = "form-control" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.Registracija, htmlAttributes: new { @class = "form-label" })
                @Html.TextBoxFor(model => model.Registracija, htmlAttributes: new { @class = "form-control" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.GodinaProizvodnje, htmlAttributes: new { @class = "form-label" })
                @Html.TextBoxFor(model => model.GodinaProizvodnje, htmlAttributes: new { @class = "form-control" })
            </div>

            <div class="text-center">
                @Html.ActionLink("Odustani","Vozila","Korisnik",new {@class="btn btn-secondary" })
                <button type="submit" class="btn btn-primary">Dodaj vozilo</button>
            </div>
        }
    </div>
</div>