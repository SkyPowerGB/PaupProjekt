
@using PaupProjekt.Models

@model List<servis>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutKorisnik.cshtml";
}

<h2>Početna korisnik</h2>

    
    @if (Model.Count > 0) {



<table border="1">


    <tr >
        <th>Vozilo </th>
        <th>Datum </th>
        <th>Opis Problema </th>
        <th>Status </th>

    </tr>
    
    @foreach (var voziloS in Model) {
    <tr>


        <th>@voziloS.voziloID    </th>
        <th>@voziloS.Datum  </th>
        <th>@voziloS.OpisProblema </th>
        <th>@voziloS.StatusServisa </th>



    </tr>}


</table>
    
    
    }

